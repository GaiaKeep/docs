#!/usr/bin/env bash
# This site is public: nothing is pushed unless the content gate and a secret scan of the outgoing
# commits pass. Installed with:  git config core.hooksPath scripts/hooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
python3 scripts/public_filter.py check docs
command -v gitleaks >/dev/null || { echo "pre-push: gitleaks not installed (brew install gitleaks); push refused"; exit 1; }
zero=0000000000000000000000000000000000000000
while read -r _ local _ remote; do
  [ "$local" = "$zero" ] && continue                         # a branch delete carries no content
  if [ "$remote" = "$zero" ]; then range="$local"; else range="$remote..$local"; fi
  gitleaks git --redact --no-banner --exit-code 1 --log-opts="$range" . || { echo "pre-push: secret scan failed on $range; push refused"; exit 1; }
done
